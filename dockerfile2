# --- Etapa 1: Construcción (Build Stage) ---
# Usamos una imagen oficial de Maven con una versión de Java (JDK) específica.
# Elige la que coincida con tu proyecto (ej. 17, 21).
# Usamos una imagen base con el JDK, ya que el wrapper se encargará de descargar Maven.
FROM eclipse-temurin:17-jdk AS build

# Establecemos el directorio de trabajo dentro del contenedor.
WORKDIR /app


# Copiamos los archivos del Maven Wrapper y el pom.xml.
# Esto nos permite descargar dependencias como una capa separada.
COPY .mvn/ .mvn
COPY mvnw pom.xml ./

# Hacemos que el script del wrapper sea ejecutable.
RUN chmod +x mvnw

# Descargamos todas las dependencias del proyecto.
RUN ./mvnw dependency:go-offline

# Copiamos el resto del código fuente de la aplicación.
COPY src ./src

# Compilamos la aplicación y la empaquetamos en un .jar, omitiendo los tests.
RUN ./mvnw package -DskipTests

# --- Etapa 2: Ejecución (Runtime Stage) ---
# Usamos una imagen base mucho más ligera que solo contiene el JRE.
# Esta etapa no cambia.
FROM eclipse-temurin:17-jre-alpine

WORKDIR /app